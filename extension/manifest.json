{
  "manifest_version": 3,
  "name": "해줌 AI — 공지를 내 할 일로",
  "version": "2.6.0",
  "minimum_chrome_version": "120",
  "description": "공지·PDF·화면을 가져오고 할 일과 마감일을 확인하는 문서 도우미",
  "permissions": ["activeTab", "scripting", "storage", "offscreen", "identity"],
  "host_permissions": ["https://tessdata.projectnaptha.com/*", "https://haezoom.sleepwhale.workers.dev/*", "https://www.googleapis.com/*", "https://oauth2.googleapis.com/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "content_scripts": [{"matches": ["file:///*.pdf", "file:///*.PDF"], "js": ["selection-helper.js"], "run_at": "document_idle"}],
  "background": {"service_worker": "background.js", "type": "module"},
  "oauth2": {
    "client_id": "644882776567-656l0moar0hc9r8fesddat2hdsenhs2l.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/calendar.events"]
  },
  "action": {"default_popup": "popup.html", "default_icon": "icon.png"},
  "icons": {"128": "icon.png"},
  "options_page": "workspace.html#settings",
  "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"}
}
